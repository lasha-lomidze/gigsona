# Development database connection string. Use a dedicated, disposable database.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Better Auth settings. Generate a unique secret; do not reuse this placeholder.
BETTER_AUTH_SECRET=replace-with-a-unique-random-secret
BETTER_AUTH_URL=http://localhost:3000

# Only needed when choosing built-in demo accounts in `npm run seed`.
# Leave blank unless you are seeding a local development database.
SEED_PASSWORD=
